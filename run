#!/usr/bin/env python3
from __future__ import annotations

import argparse
import glob
import hashlib
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

SCRIPT_DIR = Path(__file__).parent.resolve()
TEST_OUT = SCRIPT_DIR / "output" / "testing"
VENV_DIR = SCRIPT_DIR / ".venv"
VENV_BIN = VENV_DIR / "bin"
VENV_PYTHON = VENV_BIN / "python"
REQUIREMENTS = SCRIPT_DIR / "requirements.txt"
PYPROJECT = SCRIPT_DIR / "pyproject.toml"
STAMP = VENV_DIR / ".requirements.sha256"


def _bootstrap() -> None:
    if Path(sys.executable).resolve() == VENV_PYTHON.resolve():
        return
    if not VENV_DIR.exists():
        subprocess.run([sys.executable, "-m", "venv", str(VENV_DIR)], check=True)
    digest = hashlib.sha256(REQUIREMENTS.read_bytes() + PYPROJECT.read_bytes()).hexdigest()
    installed = STAMP.read_text().strip() if STAMP.exists() else ""
    if installed != digest:
        subprocess.run([str(VENV_PYTHON), "-m", "pip", "install", "-q", "-r", str(REQUIREMENTS)], check=True)
        subprocess.run([str(VENV_PYTHON), "-m", "pip", "install", "-q", "-e", str(SCRIPT_DIR)], check=True)
        STAMP.write_text(digest + "\n")
    os.execv(str(VENV_PYTHON), [str(VENV_PYTHON), str(Path(__file__).resolve()), *sys.argv[1:]])


def _shell(command: list[str], **kwargs: object) -> int:
    return subprocess.call(command, **kwargs)


def _venv(tool: str) -> str:
    return str(VENV_BIN / tool)


def command_test(args: argparse.Namespace) -> int:
    TEST_OUT.mkdir(parents=True, exist_ok=True)
    target = str(SCRIPT_DIR / args.target)
    return _shell([_venv("pytest"), "-q", target, "--maxfail=1", "--disable-warnings", "--tb=short"])


def command_lint(_: argparse.Namespace) -> int:
    return _shell([_venv("ruff"), "check", "--line-length", "120", str(SCRIPT_DIR / "src")])


def command_check(_: argparse.Namespace) -> int:
    return _shell(["dazpycheck"], cwd=str(SCRIPT_DIR))


def command_extract(args: argparse.Namespace) -> int:
    code = ";".join(
        [
            "import asyncio, json, sys, setproctitle",
            "from daz_web_extract import extract",
            "setproctitle.setproctitle('daz-web-extract')",
            f"r=asyncio.run(extract({args.url!r}))",
            f"print(json.dumps(r.to_dict(),indent=2)) if {args.raw!r} else None",
            f"print(f'Title: {{r.title}}\\nMethod: {{r.fetch_method}}\\nLength: {{r.content_length}} chars\\n"
            f"Time: {{r.elapsed_ms}}ms\\n\\n{{r.body}}') if not {args.raw!r} and r.success else None",
            f"print(f'Failed: {{r.error}}',file=sys.stderr) if not {args.raw!r} and not r.success else None",
            "sys.exit(0 if r.success else 1)",
        ]
    )
    return _shell([str(VENV_PYTHON), "-c", code])


def _project_identity() -> tuple[str, str]:
    content = PYPROJECT.read_text()
    name_match = re.search(r'name\s*=\s*"([^"]+)"', content)
    version_match = re.search(r'version\s*=\s*"(\d+\.\d+\.\d+)"', content)
    if name_match is None or version_match is None:
        raise RuntimeError("pyproject.toml is missing project name or version")
    return name_match.group(1), version_match.group(1)


def command_publish(_: argparse.Namespace) -> int:
    from daz_web_extract.publishing import pypi_token
    from twine.commands.upload import upload
    from twine.settings import Settings

    name, version = _project_identity()
    for directory in (SCRIPT_DIR / "dist", SCRIPT_DIR / "build"):
        if directory.exists():
            shutil.rmtree(directory)
    subprocess.run([str(VENV_PYTHON), "-m", "build"], cwd=SCRIPT_DIR, check=True)
    dist_files = glob.glob(str(SCRIPT_DIR / "dist" / "*"))
    if not dist_files:
        raise RuntimeError("build produced no distribution files")

    token = pypi_token()
    upload(
        Settings(username="__token__", password=token, non_interactive=True, skip_existing=True),
        dist_files,
    )

    with tempfile.TemporaryDirectory(prefix="daz-web-extract-pypi-") as download_dir:
        for attempt in range(12):
            result = subprocess.run(
                [
                    str(VENV_PYTHON),
                    "-m",
                    "pip",
                    "download",
                    "--no-deps",
                    "--dest",
                    download_dir,
                    f"{name}=={version}",
                ],
                check=False,
            )
            if result.returncode == 0:
                break
            if attempt == 11:
                raise RuntimeError(f"published {version}, but PyPI indexing verification failed")
            time.sleep(5)

    for directory in (SCRIPT_DIR / "dist", SCRIPT_DIR / "build"):
        if directory.exists():
            shutil.rmtree(directory)
    print(f"Published and verified {name} {version}")
    return 0


def command_verify(args: argparse.Namespace) -> int:
    return command_check(args)


def main(argv: list[str]) -> int:
    _bootstrap()
    parser = argparse.ArgumentParser(prog="daz-web-extract")
    sub = parser.add_subparsers(dest="cmd", required=True)

    test_parser = sub.add_parser("test", help="Run a single test target")
    test_parser.add_argument("target", help="e.g. src/daz_web_extract/result_test.py")
    test_parser.set_defaults(func=command_test)
    sub.add_parser("lint", help="Run linter").set_defaults(func=command_lint)
    sub.add_parser("check", help="Run the full quality gate").set_defaults(func=command_check)
    extract_parser = sub.add_parser("extract", help="Extract content from a URL")
    extract_parser.add_argument("url")
    extract_parser.add_argument("--raw", action="store_true")
    extract_parser.set_defaults(func=command_extract)
    sub.add_parser("publish", aliases=["deploy"], help="Publish the committed version to PyPI").set_defaults(
        func=command_publish
    )
    sub.add_parser("verify", help="Run the full quality gate").set_defaults(func=command_verify)

    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
